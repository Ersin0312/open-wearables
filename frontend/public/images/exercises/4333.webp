</style>
<style>:root {
--primary-color: #dc092f;
--primary-hover: #ec3b38;
--light-gray: #f5f5f5;
--medium-gray: #ddd;
--dark-gray: #666;
--text-color: #333;
--success-color: #4caf50;
--success-dark: #43a047;
--error-color: #f44336;
--error-dark: #c62828;
--border-radius: 12px;
--small-radius: 4px;
--box-shadow: 0 2px 5px rgba(0,0,0,0.05);
--hover-shadow: 0 4px 8px rgba(0,0,0,0.1);
--transition: all 0.3s ease;
} .fitness-category-filter h3 {
margin-bottom: 15px;
font-size: 1.2em;
}
.fitness-category-filter .category-list {
list-style: none;
padding: 0;
margin: 0;
}
.fitness-category-filter .parent-category {
margin-bottom: 15px;
}
.fitness-category-filter .child-categories {
list-style: none;
padding-left: 20px;
margin-top: 5px;
} .fitness-favorite-button {  }
.fitness-favorite-button.add-favorite:hover { }
.fitness-favorite-button.remove-favorite {
background-color: #ffffff; color: #373737;
}
.fitness-favorite-button.remove-favorite:hover {
background-color: #ffffff;
border-color: #888888;
} .fitness-favorite-icon-wrapper {
top: 10px;
right: 10px;
z-index: 10;
cursor: pointer;
}
.fitness-favorite-icon {
width: 36px;
height: 36px;
display: flex;
align-items: center;
justify-content: center;
background-color: rgba(255, 255, 255, 0.8);
border-radius: 50%;
box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
transition: var(--transition);
}
.fitness-favorite-icon:hover {
transform: scale(1.1);
background-color: #fff;
box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
} .fitness-favorite-icon svg {
fill: #ccc;
transition: fill 0.3s ease;
}
.fitness-favorite-icon:hover svg {
fill: #ff6b6b; }
.fitness-favorite-icon.is-favorite svg {
fill: var(--primary-color); } .elementor-card .fitness-favorite-icon-wrapper {
top: 15px;
right: 15px;
} .fitness-header-icon-wrap {
position: relative;
display: inline-block;
padding: 5px;
text-decoration: none;
}
.fitness-header-icon {
position: relative;
width: 35px;
height: 35px;
display: flex;
align-items: center;
justify-content: center;
border-radius: 50%;
transition: var(--transition);
}
.fitness-header-icon svg {
width: 28px;
height: 28px;
fill: transparent;
stroke: #5b5b5b;
stroke-width: 1.5;
transition: fill 0.3s ease;
}
.fitness-header-icon.has-items svg {
fill: var(--primary-color); stroke-width: 1;
}
.fitness-header-icon:hover svg {
fill: var(--primary-hover); stroke: #333;
}
.fitness-favorites-count {
position: absolute;
bottom: 3px;
right: -6px;
background-color: #f3f3f3;
color: rgb(15, 15, 15);
font-size: 10px;
height: 15px;
width: 15px;
display: flex;
align-items: center;
justify-content: center;
border-radius: 50%;
box-shadow: 0 1px 2px rgba(0,0,0,0.3);
} .fitness-favorites-list {
margin: 30px 0;
}
.fitness-no-favorites {
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
text-align: center;
padding: 20px;
margin: 0 auto;
}
.fitness-no-favorites .elementor-button {
margin-top: 15px;
} .favorites-list {
display: flex;
flex-direction: column;
gap: 10px;
margin-bottom: 20px;
}
.favorite-list-item {
display: flex;
justify-content: space-between;
align-items: center;
border: 1px solid #eaeaea;
border-radius: var(--border-radius);
overflow: hidden;
padding: 10px;
background-color: #fff;
box-shadow: var(--box-shadow);
transition: var(--transition);
margin-bottom: 10px;
}
.favorite-list-item:hover {
box-shadow: var(--hover-shadow);
border-color: var(--medium-gray);
}
.favorite-item-left {
display: flex;
align-items: center;
flex: 1;
}
.favorite-item-left .favorite-thumbnail {
width: 80px;
height: 80px;
margin-right: 15px;
border-radius: 8px;
overflow: hidden;
}
.favorite-item-left .favorite-thumbnail img {
width: 100%;
height: 100%;
object-fit: cover;
}
.favorite-item-left .favorite-details {
flex: 1;
}
.favorite-item-left .favorite-details h4 {
margin: 0 0 5px 0;
font-size: 16px;
}
.favorite-item-left .favorite-details h4 a {
color: var(--text-color);
text-decoration: none;
transition: color 0.2s;
}
.favorite-item-left .favorite-details h4 a:hover {
color: #000;
}
.favorite-item-left .favorite-excerpt {
color: var(--dark-gray);
font-size: 14px;
margin-bottom: 5px;
}
.favorite-item-right {
display: flex;
align-items: center;
gap: 20px;
}
.configure-product-link {
font-size: 14px;
color: #1976d2;
text-decoration: none;
display: inline-block;
}
.configure-product-link:hover {
text-decoration: underline;
} .quantity-selector {
display: flex;
flex-direction: column;
gap: 5px;
}
.quantity-selector label {
font-size: 13px;
color: var(--dark-gray);
font-weight: 500;
}
.quantity-controls {
display: flex;
align-items: center;
overflow: hidden;
}
.quantity-decrease,
.quantity-increase { height: 20px;
width: 2px !important;
background-color: transparent !important;
border: none !important;
cursor: pointer;
display: flex;
font-size: 24px !important;
margin-bottom: 1em !important;
font-weight: 300;
color: #0f0f0f !important;
transition: all 0.2s ease;
}
.quantity-decrease:hover,
.quantity-increase:hover {
background-color: rgba(0,0,0,0.03);
color: #333;
}
.product-quantity {
width: 56px;
height: 32px;
border: 1px  #777 solid !important;
background: transparent;
text-align: center;
font-size: 15px;
font-weight: 500;
color: #333;
-moz-appearance: textfield;
}
.product-quantity::-webkit-outer-spin-button,
.product-quantity::-webkit-inner-spin-button {
-webkit-appearance: none;
margin: 0;
}
.product-quantity:focus {
outline: none;
} .remove-from-favorites {
background-color: transparent !important;
border: none !important;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
transition: all 0.2s ease;
} .remove-from-favorites svg {
fill: #dc8989;
transition: fill 0.2s ease;
}
.remove-from-favorites:hover svg {
fill: #ec3b38;
} .fitness-inquiry-form-container {
margin-top: 30px;
background-color: #f9f9f9;
border-radius: var(--border-radius);
padding: 20px;
border: 1px solid #eee;
}
.fitness-inquiry-form-container h3 {
margin-top: 0;
margin-bottom: 20px;
}
.inquiry-form .form-row {
display: flex;
gap: 20px;
margin-bottom: 15px;
}
.inquiry-form .form-group {
margin-bottom: 15px;
flex: 1;
}
.inquiry-form .form-group.small-input {
flex: 0 0 30%;
}
.inquiry-form label {
display: block;
margin-bottom: 5px;
font-weight: 500;
}
.inquiry-form input[type="text"],
.inquiry-form input[type="email"],
.inquiry-form input[type="tel"],
.inquiry-form textarea {
width: 100%;
padding: 10px;
border: 1px solid var(--medium-gray);
border-radius: var(--small-radius);
}
.inquiry-form textarea {
resize: vertical;
min-height: 100px;
}
.selected-equipment {
margin: 20px 0;
}
.selected-equipment h4 {
margin-bottom: 10px;
}
.selected-products-table {
width: 100%;
border-collapse: collapse;
margin-top: 10px;
}
.selected-products-table th,
.selected-products-table td {
padding: 8px;
border: 1px solid var(--medium-gray);
text-align: left;
}
.selected-products-table th {
background-color: var(--light-gray);
font-weight: 500;
}
.selected-products-table .quantity-column {
text-align: center;
width: 100px;
}
.checkbox-group {
display: flex;
align-items: flex-start;
gap: 10px;
margin: 20px 0;
}
.checkbox-group input[type="checkbox"] {
margin-top: 2px;
}
.checkbox-group a {
color: #1976d2;
text-decoration: underline;
}
.send-inquiry-button {
background-color: var(--success-color);
color: white;
border: none;
padding: 10px 20px;
border-radius: var(--small-radius);
cursor: pointer;
font-weight: 500;
transition: background-color 0.3s;
}
.send-inquiry-button:hover {
background-color: var(--success-dark);
}
.send-inquiry-button:disabled {
background-color: #9e9e9e;
cursor: not-allowed;
}
.form-response {
margin-top: 15px;
}
.success-message {
padding: 10px;
background-color: #e8f5e9;
border-left: 3px solid var(--success-color);
color: #2e7d32;
}
.error-message {
padding: 10px;
background-color: #ffebee;
border-left: 3px solid var(--error-color);
color: var(--error-dark);
} .fitness-notification {
position: fixed;
bottom: 20px;
right: 20px;
padding: 15px 15px;
border-radius: 5px;
box-shadow: 0 3px 10px rgba(0,0,0,0.2);
z-index: 9999;
transform: translateY(100px);
opacity: 0;
transition: transform 0.3s, opacity 0.3s;
}
.fitness-notification.show {
transform: translateY(0);
opacity: 1;
}
.fitness-notification.success {
background-color: #ffffff;
border-left: 5px solid #000000;
color: #000000;
}
.fitness-notification.error {
background-color: #ffffff;
border-left: 5px solid var(--error-color);
color: var(--error-dark);
}
.fitness-notification.success-with-link {
background-color: #ffffff;
border-left: 5px solid var(--success-color);
color: #2e7d32;
padding-right: 50px;
}
.view-favorites-link {
display: inline-block;
margin-top: 5px;
color: #1976d2;
text-decoration: underline;
} @media (max-width: 768px) {
.fitness-header-icon-wrap {
padding: 0;
}
.inquiry-form .form-row {
flex-direction: column;
gap: 0;
}
.fitness-notification {
left: 20px;
right: 20px;
text-align: center;
}
.favorite-list-item {
flex-direction: column;
align-items: flex-start;
gap: 15px;
}
.favorite-item-left {
width: 100%;
}
.favorite-item-right {
width: 100%;
justify-content: space-between;
}
}</style>
<link rel='stylesheet' id='sf_styles-css' href='//gym80.de/wp-content/cache/wpfc-minified/q4zlffnk/g0bch.css' media='all' />
<style>.wpml-ls-legacy-list-horizontal{border:1px solid transparent;padding:7px;clear:both}.wpml-ls-legacy-list-horizontal>ul{padding:0;margin:0!important;list-style-type:none}.wpml-ls-legacy-list-horizontal .wpml-ls-item{padding:0;margin:0;list-style-type:none;display:inline-block}.wpml-ls-legacy-list-horizontal a{display:block;text-decoration:none;padding:5px 10px 6px;line-height:1}.wpml-ls-legacy-list-horizontal a span{vertical-align:middle}.wpml-ls-legacy-list-horizontal a span.wpml-ls-bracket{vertical-align:unset}.wpml-ls-legacy-list-horizontal .wpml-ls-flag{display:inline;vertical-align:middle}.wpml-ls-legacy-list-horizontal .wpml-ls-flag+span{margin-left:.4em}.rtl .wpml-ls-legacy-list-horizontal .wpml-ls-flag+span{margin-left:0;margin-right:.4em}.wpml-ls-legacy-list-horizontal.wpml-ls-statics-footer{margin-bottom:30px}.wpml-ls-legacy-list-horizontal.wpml-ls-statics-footer>ul{text-align:center}</style>
<style id="wpml-legacy-horizontal-list-0-inline-css">
.wpml-ls-flag{ border-radius: 0 !important; }
/*# sourceURL=wpml-legacy-horizontal-list-0-inline-css */
</style>
