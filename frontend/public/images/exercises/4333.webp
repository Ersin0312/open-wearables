<script>
document.addEventListener('DOMContentLoaded', function() {
function initAnimation() {
const triggerDesktop = document.querySelector('.bg-trigger');
const triggerMobile = document.querySelector('.bg-trigger-mobile');
const blockB = document.querySelector('.gym80-series');
const marquee = document.querySelector('.marquee');
const blockC = document.querySelector('.block-c');
function handleScroll() {
// Bestimme welcher Trigger aktuell sichtbar/aktiv ist
let activeTrigger = null;
if (triggerDesktop && window.getComputedStyle(triggerDesktop).display !== 'none') {
activeTrigger = triggerDesktop;
} else if (triggerMobile && window.getComputedStyle(triggerMobile).display !== 'none') {
activeTrigger = triggerMobile;
}
// Falls ein aktiver Trigger gefunden wurde
if (activeTrigger) {
const rect = activeTrigger.getBoundingClientRect();
const windowHeight = window.innerHeight;
const triggerBottom = rect.bottom;
if (triggerBottom < windowHeight * 0.8) {
if (blockB) {
blockB.classList.add('light-mode');
}
if (blockC) {
blockC.classList.add('light-mode');
}
if (marquee) {
marquee.classList.add('light-mode');
}
} else {
if (blockB) {
blockB.classList.remove('light-mode');
}
if (blockC) {
blockC.classList.remove('light-mode');
}
if (marquee) {
marquee.classList.remove('light-mode');
}
}
}
}
window.addEventListener('scroll', handleScroll);
handleScroll(); // Initial check
}
setTimeout(initAnimation, 1000);
});
</script>
</body>
